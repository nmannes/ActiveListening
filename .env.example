
# Kalshi API Credentials
KALSHI_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=path/to/your/kalshi-key.key
KALSHI_ENV=prod # 'demo' or 'prod'

KALSHI_BASE_DOMAIN=https://api.elections.kalshi.com/trade-api/v2
# App Config
LOG_LEVEL=debug
DRY_RUN=true # Set to false to actually place trades

# Transcription Config
WHISPER_MODEL=Xenova/whisper-base.en
WS_PORT=7654

# DB Config
DB_PATH=./trading.db

