{
  "manifest_version": 3,
  "name": "Audio Streamer",
  "version": "1.0",
  "description": "Streams tab audio to ws://localhost:7654",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
