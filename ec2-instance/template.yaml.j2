AWSTemplateFormatVersion: '2010-09-09'
Description: >
  Blueprint for Kalshi GPU Worker.
  Python modules in pylib/ and server.py are injected by the render script.

Parameters:
  Environment:
    Type: String
    Default: demo
    AllowedValues: [prod, demo]
  S3RecordingsBucket:
    Type: String
    Default: recordings-846345203908-us-east-1-an
  InstanceTypeOverride:
    Type: String
    Default: ""
  UseSpot:
    Type: String
    Default: 'false'
  KeyName:
    Type: AWS::EC2::KeyPair::KeyName
    Default: us-east-1
  OperatorIpv4:
    Type: String
    Default: ""
  OperatorIpv6:
    Type: String
    Default: ""
  AmiId:
    Type: String
    Default: ami-04b70fa74e45c3917
  ShutdownMinutes:
    Type: Number
    Default: 30
  KalshiKeyId:
    Type: String
    NoEcho: true
  KalshiPrivateKey:
    Type: String
    NoEcho: true
    NoEcho: true
    Default: ""
  AssignIpv6Address:
    Type: String
    Default: "false"
    AllowedValues: ["true", "false"]
  EnvContent:
    Type: String
    NoEcho: true
    Default: ""
  SubnetId:
    Type: String
    Default: ""
  VpcId:
    Type: String
    Default: ""

Conditions:
  UseSpotInstances: !Equals [!Ref UseSpot, 'true']
  HasInstanceTypeOverride: !Not [ !Equals [!Ref InstanceTypeOverride, ""] ]
  HasIpv4: !Not [ !Equals [!Ref OperatorIpv4, ""] ]
  HasIpv6: !Not [ !Equals [!Ref OperatorIpv6, ""] ]
  ShouldAssignIpv6: !Equals [!Ref AssignIpv6Address, "true"]
  HasSubnetId: !Not [ !Equals [!Ref SubnetId, ""] ]
  HasVpcId: !Not [ !Equals [!Ref VpcId, ""] ]

Mappings:
  EnvToInstanceType:
    prod:
      InstanceType: t3.large
    demo:
      InstanceType: t3.large

Resources:
  KalshiWorkerSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    DeletionPolicy: Delete
    Properties:
      GroupDescription: Security group for Kalshi Worker
      VpcId: !If [ HasVpcId, !Ref VpcId, !Ref "AWS::NoValue" ]
      SecurityGroupIngress:
        - !If [ HasIpv4, { IpProtocol: tcp, FromPort: 22, ToPort: 22, CidrIp: !Ref OperatorIpv4 }, !Ref "AWS::NoValue" ]
        - !If [ HasIpv6, { IpProtocol: tcp, FromPort: 22, ToPort: 22, CidrIpv6: !Ref OperatorIpv6 }, !Ref "AWS::NoValue" ]
        - !If [ HasIpv4, { IpProtocol: tcp, FromPort: 8090, ToPort: 8090, CidrIp: !Ref OperatorIpv4 }, !Ref "AWS::NoValue" ]
        - !If [ HasIpv6, { IpProtocol: tcp, FromPort: 8090, ToPort: 8090, CidrIpv6: !Ref OperatorIpv6 }, !Ref "AWS::NoValue" ]

  KalshiWorkerInstance:
    Type: AWS::EC2::Instance
    DeletionPolicy: Delete
    Metadata:
      AWS::CloudFormation::Init:
        config:
          packages:
            apt:
              python3-pip: []
              libsndfile1: []
              unzip: []

          files:
            "/home/ubuntu/.env":
              content: !Ref EnvContent
              mode: "000600"
              owner: "ubuntu"
              group: "ubuntu"
            "/home/ubuntu/private_key.txt":
              content: !Ref KalshiPrivateKey
              mode: "000600"
              owner: "ubuntu"
              group: "ubuntu"
            "/home/ubuntu/setup_kalshi.sh":
              content: !Sub |
                {{ setup_kalshi_sh | indent(16) }}
              mode: "000755"
              owner: ubuntu
              group: ubuntu
            "/etc/systemd/system/kalshi.service":
              content: !Sub |
                {{ kalshi_service | indent(16) }}
              mode: "000644"
              owner: root
              group: root
            "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
              content: !Sub |
                {
                  "logs": {
                    "logs_collected": {
                      "files": {
                        "collect_list": [
                          {
                            "file_path": "/var/log/cfn-init.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/cfn-init",
                            "retention_in_days": 7
                          },
                          {
                            "file_path": "/home/ubuntu/logs/setup_trace.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/setup_trace",
                            "retention_in_days": 7
                          }
                        ]
                      },
                      "journal": {
                        "collect_list": [
                          {
                            "journal_name": "systemd",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/remote_server",
                            "services": ["kalshi"]
                          }
                        ]
                      }
                    }
                  }
                }
              mode: "000644"
              owner: root
              group: root

          commands:
            00_authorize_ssh_key:
              command: |
                if [ -n "{{ ssh_public_key }}" ]; then
                  echo "{{ ssh_public_key }}" >> /home/ubuntu/.ssh/authorized_keys
                fi
            01_create_logs_dir:
              command: "mkdir -p /home/ubuntu/logs && chown ubuntu:ubuntu /home/ubuntu/logs"
            02_install_cw_agent:
              command: |
                wget https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
                dpkg -i -E ./amazon-cloudwatch-agent.deb
            03_start_cw_agent:
              command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"
            04_run_setup:
              command: "su - ubuntu -c '/home/ubuntu/setup_kalshi.sh' && touch /home/ubuntu/.setup_done"
              test: "test ! -f /home/ubuntu/.setup_done"
            05_enable_service:
              command: "systemctl enable --now kalshi"

    Properties:
      ImageId: !Ref AmiId
      InstanceType: 
        !If 
          - HasInstanceTypeOverride
          - !Ref InstanceTypeOverride
          - !FindInMap [EnvToInstanceType, !Ref Environment, InstanceType]
      KeyName: !Ref KeyName
      IamInstanceProfile: !Ref KalshiWorkerInstanceProfile
      SecurityGroupIds: 
        - !Ref KalshiWorkerSecurityGroup
      SubnetId: !If [ HasSubnetId, !Ref SubnetId, !Ref "AWS::NoValue" ]
      InstanceMarketOptions:
        !If
          - UseSpotInstances
          - MarketType: spot
          - !Ref AWS::NoValue
      Ipv6AddressCount: !If [ ShouldAssignIpv6, 1, !Ref "AWS::NoValue" ]
      MetadataOptions:
        HttpEndpoint: enabled
        HttpTokens: required
      BlockDeviceMappings:
        - DeviceName: /dev/sda1
          Ebs:
            VolumeSize: 100
            VolumeType: gp3
            DeleteOnTermination: true
      Tags:
        - Key: Name
          Value: !Sub "${AWS::StackName}"
        - Key: Environment
          Value: !Ref Environment
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          apt-get update
          apt-get install -y python3-pip
          pip3 install https://s3.amazonaws.com/cloudformation-examples/aws-cfn-bootstrap-py3-latest.tar.gz --break-system-packages
          /usr/local/bin/cfn-init -v --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
          /usr/local/bin/cfn-signal -e $? --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
    CreationPolicy:
      ResourceSignal:
        Timeout: PT30M


  KalshiWorkerInstanceRole:
    Type: AWS::IAM::Role
    DeletionPolicy: Delete
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: S3RecordingsWriteAccess
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action:
                  - s3:PutObject
                Resource: !Sub "arn:aws:s3:::${S3RecordingsBucket}/*"
              - Effect: Allow
                Action:
                  - bedrock:InvokeModel
                Resource:
                  - !Sub "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0"
                  - !Sub "arn:aws:bedrock:*:${AWS::AccountId}:inference-profile/us.amazon.nova-lite-v1:0"
              - Effect: Allow
                Action:
                  - cloudformation:DeleteStack
                Resource: !Sub "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
              - Effect: Allow
                Action:
                  - cloudformation:SignalResource
                Resource: !Sub "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy

  KalshiWorkerInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    DeletionPolicy: Delete
    Properties:
      Roles:
        - !Ref KalshiWorkerInstanceRole

Outputs:
  InstanceId:
    Value: !Ref KalshiWorkerInstance
  PublicIp:
    Value: !GetAtt KalshiWorkerInstance.PublicIp
  PrivateIp:
    Value: !GetAtt KalshiWorkerInstance.PrivateIp

