AWSTemplateFormatVersion: '2010-09-09'
Description: >
  Blueprint for Kalshi GPU Worker.
  Python modules in pylib/ and server.py are injected by the render script.

Parameters:
  Environment:
    Type: String
    Default: demo
    AllowedValues: [prod, demo]
  InstanceTypeOverride:
    Type: String
    Default: ""
  UseSpot:
    Type: String
    Default: 'false'
  KeyName:
    Type: AWS::EC2::KeyPair::KeyName
    Default: us-east-1
  OperatorIp:
    Type: String
  AmiId:
    Type: String
    Default: ami-0bbf3a5a5f8ea3603
  ShutdownMinutes:
    Type: Number
    Default: 30
  KalshiKeyId:
    Type: String
    NoEcho: true
  KalshiPrivateKey:
    Type: String
    NoEcho: true

Conditions:
  UseSpotInstances: !Equals [!Ref UseSpot, 'true']
  HasInstanceTypeOverride: !Not [ !Equals [!Ref InstanceTypeOverride, ""] ]

Mappings:
  EnvToInstanceType:
    prod:
      InstanceType: g6.xlarge
    demo:
      InstanceType: t3.large

Resources:
  KalshiWorkerSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Kalshi Worker
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: !Ref OperatorIp
        - IpProtocol: tcp
          FromPort: 8090
          ToPort: 8090
          CidrIp: !Ref OperatorIp

  KalshiWorkerInstance:
    Type: AWS::EC2::Instance
    Metadata:
      AWS::CloudFormation::Init:
        config:
          packages:
            yum:
              python3-pip: []
              amazon-cloudwatch-agent: []

          files:
            "/home/ec2-user/.env":
              content: !Sub |
                KALSHI_KEY_ID=${KalshiKeyId}
                KALSHI_PRIVATE_KEY_PATH=/home/ec2-user/private_key.txt
                KALSHI_ENV=${Environment}
                KALSHI_BASE_DOMAIN=${!If [!Equals [!Ref Environment, "prod"], "https://api.elections.kalshi.com/trade-api/v2", "https://demo-api.kalshi.co/trade-api/v2"]}
                LOG_LEVEL=info
                WHISPER_MODEL=Xenova/whisper-base.en
                ENABLE_TRADING=true
              mode: "000600"
              owner: "ec2-user"
              group: "ec2-user"
            "/home/ec2-user/private_key.txt":
              content: !Ref KalshiPrivateKey
              mode: "000600"
              owner: "ec2-user"
              group: "ec2-user"
            "/home/ec2-user/requirements.txt":
              content: |
                faster-whisper
                numpy
                dotenv
                websockets
                kalshi-python-sync
                open-clip-torch
                pillow
              mode: "000644"
              owner: "ec2-user"
              group: "ec2-user"
            "/home/ec2-user/pylib/__init__.py":
              content: |
{{ pylib___init___py | indent(16, true) | default('# init') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/pylib/audio_decoder.py":
              content: |
{{ pylib_audio_decoder_py | indent(16, true) | default('# missing') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/pylib/clip.py":
              content: |
{{ pylib_clip_py | indent(16, true) | default('# missing') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/pylib/kalshi_client.py":
              content: |
{{ pylib_kalshi_client_py | indent(16, true) | default('# missing') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/pylib/keyword_matching.py":
              content: |
{{ pylib_keyword_matching_py | indent(16, true) | default('# missing') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/pylib/transcriber.py":
              content: |
{{ pylib_transcriber_py | indent(16, true) | default('# missing') }}
              mode: "000644"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/server.py":
              content: |
{{ server_py | indent(16, true) | default('# missing') }}
              mode: "000755"
              owner: ec2-user
              group: ec2-user
            "/home/ec2-user/setup_kalshi.sh":
              content: !Sub |
{{ setup_kalshi_sh | indent(16, true) }}
              mode: "000755"
              owner: ec2-user
              group: ec2-user
            "/etc/systemd/system/kalshi.service":
              content: !Sub |
{{ kalshi_service | indent(16, true) }}

              mode: "000644"
              owner: root
              group: root
            "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
              content: !Sub |
                {
                  "logs": {
                    "logs_collected": {
                      "files": {
                        "collect_list": [
                          {
                            "file_path": "/var/log/cfn-init.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/cfn-init",
                            "retention_in_days": 7
                          },
                          {
                            "file_path": "/home/ec2-user/logs/remote_server.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/remote_server",
                            "retention_in_days": 7
                          },
                          {
                            "file_path": "/home/ec2-user/logs/setup_trace.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/setup_trace",
                            "retention_in_days": 7
                          }
                        ]
                      }
                    }
                  }
                }
              mode: "000644"
              owner: root
              group: root

          commands:
            01_run_setup:
              command: "su - ec2-user -c '/home/ec2-user/setup_kalshi.sh'"
            02_start_cw_agent:
              command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"
            03_enable_service:
                command: "systemctl enable --now kalshi"

    Properties:
      ImageId: !Ref AmiId
      InstanceType: 
        !If 
          - HasInstanceTypeOverride
          - !Ref InstanceTypeOverride
          - !FindInMap [EnvToInstanceType, !Ref Environment, InstanceType]
      KeyName: !Ref KeyName
      IamInstanceProfile: !Ref KalshiWorkerInstanceProfile
      SecurityGroupIds: 
        - !Ref KalshiWorkerSecurityGroup
      InstanceMarketOptions:
        !If
          - UseSpotInstances
          - MarketType: spot
          - !Ref AWS::NoValue
      MetadataOptions:
        HttpEndpoint: enabled
        HttpTokens: required
      BlockDeviceMappings:
        - DeviceName: /dev/xvda
          Ebs:
            VolumeSize: 100
            VolumeType: gp3
            DeleteOnTermination: true
      Tags:
        - Key: Name
          Value: !Sub "Kalshi-Worker-${AWS::StackName}"
        - Key: Environment
          Value: !Ref Environment
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          yum update -y
          yum install -y aws-cfn-bootstrap
          /opt/aws/bin/cfn-init -v --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
          /opt/aws/bin/cfn-signal -e $? --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
    CreationPolicy:
      ResourceSignal:
        Timeout: PT20M


  KalshiWorkerInstanceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy

  KalshiWorkerInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles:
        - !Ref KalshiWorkerInstanceRole

Outputs:
  InstanceId:
    Value: !Ref KalshiWorkerInstance
  PublicIp:
    Value: !GetAtt KalshiWorkerInstance.PublicIp

