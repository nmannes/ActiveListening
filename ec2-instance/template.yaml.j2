AWSTemplateFormatVersion: '2010-09-09'
Description: >
  Blueprint for Kalshi GPU Worker.
  Python modules in pylib/ and server.py are injected by the render script.

Parameters:
  Environment:
    Type: String
    Default: demo
    AllowedValues: [prod, demo]
  S3RecordingsBucket:
    Type: String
    Default: recordings-846345203908-us-east-1-an
  InstanceTypeOverride:
    Type: String
    Default: ""
  UseSpot:
    Type: String
    Default: 'false'
  KeyName:
    Type: AWS::EC2::KeyPair::KeyName
    Default: us-east-1
  OperatorIp:
    Type: String
    Default: {{ current_ip_cidr }}
  OperatorIpVersion:
    Type: String
    Default: {{ current_ip_version }}
    AllowedValues: [IPv4, IPv6]
  AmiId:
    Type: String
    Default: ami-0ec10929233384c7f
  ShutdownMinutes:
    Type: Number
    Default: 30
  KalshiKeyId:
    Type: String
    NoEcho: true
  KalshiPrivateKey:
    Type: String
    NoEcho: true
  EnvContent:
    Type: String
    NoEcho: true
    Default: ""

Conditions:
  UseSpotInstances: !Equals [!Ref UseSpot, 'true']
  HasInstanceTypeOverride: !Not [ !Equals [!Ref InstanceTypeOverride, ""] ]
  IsIpv6: !Equals [ !Ref OperatorIpVersion, "IPv6" ]
  IsIpv4: !Not [ !Condition IsIpv6 ]

Mappings:
  EnvToInstanceType:
    prod:
      InstanceType: t3.large
    demo:
      InstanceType: t3.large

Resources:
  KalshiWorkerSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    DeletionPolicy: Delete
    Properties:
      GroupDescription: Security group for Kalshi Worker
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: !If [ IsIpv4, !Ref OperatorIp, !Ref "AWS::NoValue" ]
          CidrIpv6: !If [ IsIpv6, !Ref OperatorIp, !Ref "AWS::NoValue" ]
        - IpProtocol: tcp
          FromPort: 8090
          ToPort: 8090
          CidrIp: !If [ IsIpv4, !Ref OperatorIp, !Ref "AWS::NoValue" ]
          CidrIpv6: !If [ IsIpv6, !Ref OperatorIp, !Ref "AWS::NoValue" ]

  KalshiWorkerInstance:
    Type: AWS::EC2::Instance
    DeletionPolicy: Delete
    Metadata:
      AWS::CloudFormation::Init:
        config:
          packages:
            yum:
              python3-pip: []
              amazon-cloudwatch-agent: []
              libsndfile: []
              unzip: []

          files:
            "/home/ec2-user/.env":
              content: !Ref EnvContent
              mode: "000600"
              owner: "ec2-user"
              group: "ec2-user"
            "/home/ec2-user/private_key.txt":
              content: !Ref KalshiPrivateKey
              mode: "000600"
              owner: "ec2-user"
              group: "ec2-user"
            "/home/ec2-user/setup_kalshi.sh":
              content: !Sub |
                {{ setup_kalshi_sh | indent(16) }}
              mode: "000755"
              owner: ec2-user
              group: ec2-user
            "/etc/systemd/system/kalshi.service":
              content: !Sub |
                {{ kalshi_service | indent(16) }}
              mode: "000644"
              owner: root
              group: root
            "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
              content: !Sub |
                {
                  "logs": {
                    "logs_collected": {
                      "files": {
                        "collect_list": [
                          {
                            "file_path": "/var/log/cfn-init.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/cfn-init",
                            "retention_in_days": 7
                          },
                          {
                            "file_path": "/home/ec2-user/logs/remote_server.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/remote_server",
                            "retention_in_days": 7
                          },
                          {
                            "file_path": "/home/ec2-user/logs/setup_trace.log",
                            "log_group_name": "/kalshi/worker",
                            "log_stream_name": "{instance_id}/setup_trace",
                            "retention_in_days": 7
                          }
                        ]
                      }
                    }
                  }
                }
              mode: "000644"
              owner: root
              group: root

          commands:
            01_run_setup:
              command: "su - ec2-user -c '/home/ec2-user/setup_kalshi.sh' && touch /home/ec2-user/.setup_done"
              test: "test ! -f /home/ec2-user/.setup_done"
            02_start_cw_agent:
              command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"
            03_enable_service:
              command: "systemctl enable --now kalshi"

    Properties:
      ImageId: !Ref AmiId
      InstanceType: 
        !If 
          - HasInstanceTypeOverride
          - !Ref InstanceTypeOverride
          - !FindInMap [EnvToInstanceType, !Ref Environment, InstanceType]
      KeyName: !Ref KeyName
      IamInstanceProfile: !Ref KalshiWorkerInstanceProfile
      SecurityGroupIds: 
        - !Ref KalshiWorkerSecurityGroup
      InstanceMarketOptions:
        !If
          - UseSpotInstances
          - MarketType: spot
          - !Ref AWS::NoValue
      MetadataOptions:
        HttpEndpoint: enabled
        HttpTokens: required
      BlockDeviceMappings:
        - DeviceName: /dev/xvda
          Ebs:
            VolumeSize: 100
            VolumeType: gp3
            DeleteOnTermination: true
      Tags:
        - Key: Name
          Value: !Sub "${AWS::StackName}"
        - Key: Environment
          Value: !Ref Environment
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          yum install -y aws-cfn-bootstrap
          /opt/aws/bin/cfn-init -v --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
          /opt/aws/bin/cfn-signal -e $? --stack ${AWS::StackName} --resource KalshiWorkerInstance --region ${AWS::Region}
    CreationPolicy:
      ResourceSignal:
        Timeout: PT30M


  KalshiWorkerInstanceRole:
    Type: AWS::IAM::Role
    DeletionPolicy: Delete
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: S3RecordingsWriteAccess
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action:
                  - s3:PutObject
                Resource: !Sub "arn:aws:s3:::${S3RecordingsBucket}/*"
              - Effect: Allow
                Action:
                  - bedrock:InvokeModel
                Resource:
                  - !Sub "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0"
                  - !Sub "arn:aws:bedrock:*:${AWS::AccountId}:inference-profile/us.amazon.nova-lite-v1:0"
              - Effect: Allow
                Action:
                  - cloudformation:DeleteStack
                Resource: !Sub "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
              - Effect: Allow
                Action:
                  - cloudformation:SignalResource
                Resource: !Sub "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${AWS::StackName}/*"
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy

  KalshiWorkerInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    DeletionPolicy: Delete
    Properties:
      Roles:
        - !Ref KalshiWorkerInstanceRole

Outputs:
  InstanceId:
    Value: !Ref KalshiWorkerInstance
  PublicIp:
    Value: !GetAtt KalshiWorkerInstance.PublicIp

