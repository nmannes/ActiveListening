#!/bin/bash
set -ex

# Handle default user home directory
HOME_DIR="/home/ubuntu"
mkdir -p "$HOME_DIR/logs" "$HOME_DIR/debug"
exec > >(tee -a "$HOME_DIR/logs/setup_trace.log") 2>&1
echo "Starting setup_kalshi.sh at $(date)"

sudo apt-get update
sudo apt-get install -y python3-pip git build-essential libssl-dev zlib1g-dev \
    libbz2-dev libreadline-dev libsqlite3-dev curl \
    libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev

# Instead of just shutting down, we schedule the deletion of the entire stack.
# This ensures the IAM role and other resources are cleaned up.
STACK_NAME="${AWS::StackName}"
REGION="${AWS::Region}"

if [ -z "$STACK_NAME" ]; then
    echo "Warning: AWS_STACK_NAME not found, falling back to basic shutdown timer."
    sudo shutdown -h +${ShutdownMinutes}
fi


echo "[1/5] Installing Bun..."
curl -fsSL https://bun.sh/install | bash

echo "export BUN_INSTALL=\"$HOME_DIR/.bun\"" >> "$HOME_DIR/.bashrc"
echo 'export PATH="$BUN_INSTALL/bin:$PATH"' >> "$HOME_DIR/.bashrc"

# shellcheck source=/dev/null
source "$HOME_DIR/.bashrc" || true

if ! command -v ffmpeg &> /dev/null; then
    echo "[2/5] Installing FFmpeg..."
    URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz"
    curl -L -o ffmpeg.tar.xz "$URL"
    mkdir -p ffmpeg_tmp
    tar -xvf ffmpeg.tar.xz -C ffmpeg_tmp --strip-components=1 > /dev/null
    sudo mv ffmpeg_tmp/bin/ffmpeg /usr/local/bin/
    sudo mv ffmpeg_tmp/bin/ffprobe /usr/local/bin/
    rm -rf ffmpeg_tmp ffmpeg.tar.xz
fi


echo "[2.5/5] Installing Google Chrome..."
wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
sudo apt-get install -y ./google-chrome-stable_current_amd64.deb
rm google-chrome-stable_current_amd64.deb

GITLAB_TOKEN=$(grep GITLAB_TOKEN .env | cut -d'=' -f2)

echo "[3/5] Installing Pyenv/python..."
if [ ! -d "$HOME_DIR/.pyenv" ]; then
    curl https://pyenv.run | bash
fi

# Ensure pyenv is in the path for the rest of this script
export PYENV_ROOT="$HOME_DIR/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"

# Setup bashrc for future logins
echo "export PYENV_ROOT=\"$HOME_DIR/.pyenv\"" >> "$HOME_DIR/.bashrc"
echo 'export PATH="$PYENV_ROOT/bin:$PATH"' >> "$HOME_DIR/.bashrc"
echo 'eval "$(pyenv init -)"' >> "$HOME_DIR/.bashrc"

# Initialize pyenv for the current script
eval "$(pyenv init -)"

if ! pyenv versions | grep -q "3.10.19"; then
    echo "This may take 5-10 minutes..."
    pyenv install 3.10.19
fi
pyenv global 3.10.19

echo "[4/5] Cloning repository..."
if [ ! -d "kalshi" ]; then
    git clone "https://oauth2:$GITLAB_TOKEN@gitlab.com/nmannes/kalshi.git"
fi

cd kalshi
cp ../.env .

# Use a custom TMPDIR to avoid filling up /tmp (which might be small on some AMIs)
mkdir -p "$HOME_DIR/pip_tmp"
export TMPDIR="$HOME_DIR/pip_tmp"

# Force CPU-only versions of torch and torchaudio first to prevent pip from downloading GPU wheels
echo "[5/5] Installing dependencies..."
pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install open-clip-torch from PyPI (it depends on torch, which we just installed)
pip install --no-cache-dir open-clip-torch

pip install -r "$HOME_DIR/kalshi/requirements.txt"

rm -rf "$HOME_DIR/pip_tmp"
