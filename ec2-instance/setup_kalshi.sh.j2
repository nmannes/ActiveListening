#!/bin/bash
set -ex

# Handle default user home directory
HOME_DIR="/home/ubuntu"
mkdir -p "$HOME_DIR/logs" "$HOME_DIR/debug"
exec > >(tee -a "$HOME_DIR/logs/setup_trace.log") 2>&1
echo "Starting setup_kalshi.sh at $(date)"

# xtrace stays off while sourcing: this script's output is teed into setup_trace.log,
# which the CloudWatch agent ships, and `set -x` would print every .env value
set +x
set -a && source .env && set +a
set -x

# Function to log errors before exiting
error_handler() {
    echo "ERROR: setup_kalshi.sh failed at line $1"
}
trap 'error_handler $LINENO' ERR

sudo apt-get update
sudo apt-get install -y python3-pip git build-essential libssl-dev zlib1g-dev \
    libbz2-dev libreadline-dev libsqlite3-dev curl \
    libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev

# Instead of just shutting down, we schedule the deletion of the entire stack.
# This ensures the IAM role and other resources are cleaned up.
STACK_NAME="${AWS::StackName}"
REGION="${AWS::Region}"

sudo shutdown -h +${ShutdownMinutes}

echo "[1/5] Installing Bun..."
curl -fsSL https://bun.sh/install | bash

echo "export BUN_INSTALL=\"$HOME_DIR/.bun\"" >> "$HOME_DIR/.bashrc"
echo 'export PATH="$BUN_INSTALL/bin:$PATH"' >> "$HOME_DIR/.bashrc"

# shellcheck source=/dev/null
source "$HOME_DIR/.bashrc" || true

if ! command -v ffmpeg &> /dev/null; then
    echo "[2/5] Installing FFmpeg..."
    URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz"
    curl -L -o ffmpeg.tar.xz "$URL"
    mkdir -p ffmpeg_tmp
    tar -xvf ffmpeg.tar.xz -C ffmpeg_tmp --strip-components=1 > /dev/null
    sudo mv ffmpeg_tmp/bin/ffmpeg /usr/local/bin/
    sudo mv ffmpeg_tmp/bin/ffprobe /usr/local/bin/
    rm -rf ffmpeg_tmp ffmpeg.tar.xz
fi


echo "[2.5/5] Installing Google Chrome..."
wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
sudo apt-get install -y ./google-chrome-stable_current_amd64.deb
rm google-chrome-stable_current_amd64.deb

if [ -z "$GITLAB_TOKEN" ]; then
    echo "ERROR: GITLAB_TOKEN not found in .env"
    exit 1
fi

echo "[3/5] Installing uv..."
curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="$HOME_DIR/.local/bin:$PATH"
echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME_DIR/.bashrc"

echo "Installing Python 3.10.19 via uv..."
uv python install 3.10.19

echo "[4/5] Cloning repository..."
if [ ! -d "kalshi" ]; then
    git clone "https://oauth2:$GITLAB_TOKEN@gitlab.com/nmannes/kalshi.git"
fi

cd kalshi
cp ../.env .

# Create virtualenv via uv
uv venv .venv --python 3.10.19
source .venv/bin/activate

# Force CPU-only versions of torch, torchvision, and torchaudio first to prevent download of GPU wheels
echo "[5/5] Installing dependencies via uv..."
uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match

# Fix for youtokentome: install build dependencies manually and disable isolation
uv pip install Cython setuptools
uv pip install youtokentome --no-build-isolation

# Install open-clip-torch and other requirements
uv pip install open-clip-torch --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match
# pyyaml 5.4.1 is forced by nemo_toolkit[asr]'s pyyaml<6 pin and has no cp310 wheel, so it
# builds from source. Its build env pulls an unpinned Cython, and Cython >=3.3 dropped the
# build_ext.cython_sources method pyyaml's setup.py calls, so the build dies. Pin Cython 0.29.
echo 'Cython<3' > /tmp/build-constraints.txt
uv pip install -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match --build-constraint /tmp/build-constraints.txt
