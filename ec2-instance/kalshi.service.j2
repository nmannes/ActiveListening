[Unit]
Description=Kalshi Transcription & Trading Server
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user
EnvironmentFile=/home/ec2-user/.env
ExecStartPre=/bin/bash -c "source /home/ec2-user/.cuda_env || true"
ExecStart=/usr/bin/python3 /home/ec2-user/server.py --env ${Environment} --port 8090 --device cuda
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
