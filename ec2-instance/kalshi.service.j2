[Unit]
Description=Kalshi Transcription & Trading Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kalshi
EnvironmentFile=/home/ubuntu/.env
ExecStart=/home/ubuntu/kalshi/.venv/bin/python3 /home/ubuntu/kalshi/server.py --env ${Environment} --port 8090
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/logs/remote_server.log
StandardError=append:/home/ubuntu/logs/remote_server.log

[Install]
WantedBy=multi-user.target