[Unit]
Description=Kalshi Transcription & Trading Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/.env
ExecStart=/usr/bin/python3 /home/ubuntu/kalshi/server.py --env ${Environment} --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target